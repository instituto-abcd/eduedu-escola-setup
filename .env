APP_ADDRESS=127.0.0.1
APP_VERSION=1.4.0-beta01

# Versoes de teste (prerelease). Mantenha "false" em escola: com "true" o instalador passa
# a oferecer betas e release candidates como um item ADICIONAL no menu, sempre rotulado e
# com confirmacao. Alternativa pontual, sem editar arquivo: definir EDUEDU_BETA=1 no
# ambiente antes de executar o instalador.
ALLOW_PRERELEASE=false

# Postgres
POSTGRES_DB="edueduescola"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="senhaS3creta"
POSTGRES_PORT=5432
POSTGRES_DATA=./postgres-data

# Mongo
MONGO_INITDB_ROOT_USERNAME="root"
MONGO_INITDB_ROOT_PASSWORD="senhaS3creta"
MONGO_PORT=27017
MONGODB_DATA=./mongodb-data

# Admin & Aluno
ADMIN_PORT=8080
ALUNO_PORT=9090

# Backend
DATABASE_URL=postgresql://postgres:senhaS3creta@postgres:5432/edueduescola?schema=public
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=senhaS3creta
MONGO_INITDB_DATABASE=eduedu
MONGO_USER="root"
MONGO_PASSWORD="senhaS3creta"
MONGO_URI=mongodb://root:senhaS3creta@mongo:27017/eduedu?authSource=admin
API_PORT=3000

# App URL (Vai ser atualizada pelo script de instalÃ§Ã£o)
APP_URL=
API_URL=
ADMIN_URL=

# File Server
ASSETS="LOCAL"
FILE_SERVER_URL=
FILE_SERVER_DATA=./assets-data
REDIS_URL="host.docker.internal"

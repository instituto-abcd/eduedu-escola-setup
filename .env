APP_ADDRESS=127.0.0.1
APP_VERSION=v1.4.0

# Postgres
POSTGRES_DB="edueduescola"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="senhaS3creta"
POSTGRES_PORT=5432
POSTGRES_DATA=./postgres-data

# Mongo
MONGO_INITDB_ROOT_USERNAME="root"
MONGO_INITDB_ROOT_PASSWORD="senhaS3creta"
MONGO_PORT=27017
MONGODB_DATA=./mongodb-data

# Admin & Aluno
ADMIN_PORT=8080
ALUNO_PORT=9090

# Backend
DATABASE_URL=postgresql://postgres:senhaS3creta@postgres:5432/edueduescola?schema=public
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=senhaS3creta
MONGO_INITDB_DATABASE=eduedu
MONGO_USER="root"
MONGO_PASSWORD="senhaS3creta"
# Atencao: o banco no caminho da MONGO_URI (/eduedu) NAO e o banco que a
# aplicacao usa. O backend passa dbName explicito ao Mongoose
# (DB_MONGO, default 'eduedu-escola-admin'), entao o caminho daqui e
# ignorado - ele serve so para autenticacao. Quem for mexer em dump ou
# restore precisa usar DB_MONGO, nao este caminho.
MONGO_URI=mongodb://root:senhaS3creta@mongo:27017/eduedu?authSource=admin
API_PORT=3000

# App URL (Vai ser atualizada pelo script de instalção)
APP_URL=
API_URL=
ADMIN_URL=

# File Server
ASSETS="LOCAL"
FILE_SERVER_URL=
FILE_SERVER_DATA=./assets-data
REDIS_URL="host.docker.internal"

# Backup
# Pasta onde os backups (manuais e agendados) sao gravados, na raiz da
# instalacao. O compose mantem o default ./backup-data para instalacoes
# antigas continuarem subindo mesmo sem esta chave.
BACKUP_DATA=./backup-data
# Fuso em que o dia e a hora do backup agendado semanal sao interpretados.
# Os containers rodam em UTC; sem isto, 'domingo as 02:00' cairia as 23:00
# de sabado no horario de Brasilia. Fixo por instalacao, e nao configuravel
# na tela: e caracteristica da maquina, nao preferencia da escola.
BACKUP_TIME_ZONE=America/Sao_Paulo
